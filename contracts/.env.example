# BUIDL CTC 2026 Fall — VaultAuthorityLedger
#
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# IMPORTANT: generate a FRESH, project-only testnet keypair. Do not reuse any existing
# wallet, and never fund this address on mainnet. To generate one:
#
#   node -e "const {ethers}=require('ethers');const w=ethers.Wallet.createRandom();\
#   console.log('DEPLOYER_PRIVATE_KEY='+w.privateKey);console.log('DEPLOYER_ADDRESS='+w.address)"
#
# Then fund it via the Creditcoin Discord faucet (manual step — see README):
#   1. join https://discord.gg/creditcoin
#   2. in #token-faucet post:  /faucet address:<DEPLOYER_ADDRESS>

DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# CC3 Testnet (official values, verified 2026-08-17)
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Optional overrides used by spike/ scripts
# SOURCE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# ETH_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
# PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network
